#!/usr/bin/env bash
# Dynamic launcher: always exec the newest installed opencode from mise.
# Discovers version directories under mise's opencode install root and picks
# the highest (semver) real directory, ignoring alias symlinks (latest, global,
# 1, 1.19, 2, 2.2, ...). Falls back to `mise x opencode@latest` if no
# installed version is found.
set -euo pipefail

mise_installs="${HOME}/.local/share/mise/installs/opencode"

candidate=""
if [[ -d "$mise_installs" ]]; then
  mapfile -t versions < <(
    find "$mise_installs" -mindepth 1 -maxdepth 1 2>/dev/null \
      | while IFS= read -r d; do
          [[ -L "$d" ]] && continue
          [[ -d "$d" ]] || continue
          [[ -x "$d/node_modules/.bin/opencode" ]] || continue
          basename "$d"
        done \
      | sort -V
  )
  if [[ ${#versions[@]} -gt 0 ]]; then
    last="${versions[-1]}"
    cand="$mise_installs/$last/node_modules/.bin/opencode"
    [[ -x "$cand" ]] && candidate="$cand"
  fi
fi

if [[ -n "$candidate" ]]; then
  exec "$candidate" "$@"
fi

mise_bin="${HOME}/.local/bin/mise"
if [[ -x "$mise_bin" ]]; then
  exec "$mise_bin" x "opencode@latest" -- opencode "$@"
fi

echo "opencode: no mise install found (looked in $mise_installs)" >&2
exit 127
