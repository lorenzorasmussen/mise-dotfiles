#!/usr/bin/env bash
# shell-completions-refresh — generate and maintain the shell completion
# scripts loaded by ~/.config/shell/agent-completions.sh.
#
# Called from that loader (detached, at most once per 24h) and runnable by
# hand. Regenerates a script only when the CLI's version fingerprint changed,
# so an unchanged toolset costs one `--version` call per tool and no writes.
#
#   shell-completions-refresh            # incremental
#   shell-completions-refresh --force    # ignore fingerprints, rewrite all
#   shell-completions-refresh --quiet    # no stdout (used from the rc path)
#
# Output goes to $XDG_CACHE_HOME/shell-completions, never to a source tree:
# these are build artifacts that go stale on every CLI upgrade. The fingerprint
# file lives beside them, so wiping the cache is always safe — everything is
# regenerated on the next shell start.
#
# Log: $HOME/.local/state/shell-completions.log

set -u

CDIR="${XDG_CACHE_HOME:-$HOME/.cache}/shell-completions"
LOG="$HOME/.local/state/shell-completions.log"
STAMP="$CDIR/.versions"

force=0
quiet=0
for arg in "$@"; do
    case "$arg" in
        --force) force=1 ;;
        --quiet) quiet=1 ;;
        -h|--help) sed -n '2,20p' "$0" | cut -c3-; exit 0 ;;
        *) printf 'shell-completions-refresh: unknown argument: %s\n' "$arg" >&2; exit 2 ;;
    esac
done

say() { [ "$quiet" = 1 ] || printf '%s\n' "$*"; }
mkdir -p "$CDIR" "$(dirname "$LOG")" 2>/dev/null

# tool|generator-subcommand-argv|bash-and-zsh (y/n)
#
# Two syntaxes, not one: most of these CLIs take the shell as a positional
# argument, but gh requires `-s <shell>`. `gh completion zsh` silently emits
# the *bash* script (measured 2026-10-06: 15913 bytes, same as `-s bash`), so
# getting this wrong produces a file that looks fine and never completes.
#
# opencode is bash-only: `opencode completion zsh` is byte-identical to its
# bash output (930 bytes) because the subcommand ignores the shell argument.
# Sourcing a `complete -F` bash script into zsh is a no-op, so rather than
# ship a silent no-op we ship nothing and say so here.
#
# Added 2026-10-14 — the rest of the mise toolchain that has a generator. Each
# argv was measured, not assumed:
#   bun            `bun completions [bash|zsh]` ignores the argument and always
#                  emits the same 11.5KB bash script (`complete -F
#                  _bun_completions bun`) -> bash-only, like opencode.
#   uv             `uv generate-shell-completion bash|zsh` — 483KB/569KB, real
#                  and different per shell. Huge, but the bash stub only sources
#                  it on first TAB and zsh autoloads `_uv` on demand.
#   pnpm           `pnpm completion bash|zsh` — 1007B/310B, real per shell.
#   opensearch-cli `opensearch-cli completion bash|zsh` — 36KB/7.7KB, real.
#   mise           already covered above (its own completion is in this table).
#
# Tools with NO usable generator, checked 2026-10-14 and deliberately absent:
#   claude (rc=1, needs login), gemini (rc=55), qwen/cursor-agent/muse/pi
#   (interactive, no subcommand), agy (rc=2), agent-browser, antigravity-cli
#   (not on PATH). Runtimes go/java/node/python/ruby ship none.
#
# yazi has no generator either — it ships its completion files — and is handled
# by the SHIPPED table below, not here.
#
# Verified working 2026-10-06 on the versions pinned in ~/.config/mise/config.toml.
TOOLS='
herdr|completion|yes
omp|completions|yes
codex|completion|yes
copilot|completion|yes
gh|completion -s|yes
grok|completions|yes
mise|completion|yes
opencode|completion|no
bun|completions|no
uv|generate-shell-completion|yes
pnpm|completion|yes
opensearch-cli|completion|yes
'

# Tools that ship their completion files inside the installed package instead
# of offering a generator subcommand. Format: tool|space-separated commands.
#
# `mise where <tool>` resolves the versioned install dir; the files live under a
# completions/ subdir and cover more than one command, so each is copied under
# the name the loader and zsh's compinit expect: <cmd>.bash for bash, _<cmd> for
# zsh. Measured 2026-10-14: yazi 26.9.1 ships
# completions/{yazi,ya}.bash and completions/_{yazi,ya} under
# ~/.local/share/mise/installs/yazi/<ver>/yazi-<triple>/completions/.
SHIPPED='
yazi|yazi ya
'

# Fingerprint: first line of `<tool> --version`, whitespace-collapsed. Some of
# these print banners before the version (opencode prints its logo), so the
# first matching line is used rather than the first line.
fingerprint() {
    local tool=$1 out
    out=$(timeout 20 "$tool" --version 2>/dev/null) || return 1
    printf '%s\n' "$out" |
        tr '\n' ' ' |
        tr -s ' ' |
        sed 's/^ //; s/ $//'
}

previous_for() { sed -n "s/^$1=//p" "$STAMP" 2>/dev/null | head -1; }

regen=0
[ "$force" = 1 ] && regen=1

changed=0
: > "$CDIR/.versions.new"

while IFS='|' read -r tool argv both; do
    [ -n "${tool:-}" ] || continue

    if ! command -v "$tool" >/dev/null 2>&1; then
        printf '%s: not on PATH, skipping\n' "$tool" >>"$LOG"
        continue
    fi

    fp=$(fingerprint "$tool") || {
        printf '%s: could not read --version, skipping\n' "$tool" >>"$LOG"
        continue
    }
    printf '%s=%s\n' "$tool" "$fp" >> "$CDIR/.versions.new"

    if [ "$regen" = 1 ]; then
        :
    elif [ "$fp" = "$(previous_for "$tool")" ] &&
         [ -s "$CDIR/$tool.bash" ] &&
         { [ "$both" = no ] || [ -s "$CDIR/_$tool" ]; }; then
        continue
    fi

    did=0
    # bash: clobber with a temp file then move, so a partial write never
    # replaces a working script (the loader sources these at shell start).
    if timeout 60 "$tool" $argv bash > "$CDIR/.$tool.bash.tmp" 2>>"$LOG"; then
        mv -f "$CDIR/.$tool.bash.tmp" "$CDIR/$tool.bash" && did=1
    else
        rm -f "$CDIR/.$tool.bash.tmp"
        printf '%s: bash generator failed\n' "$tool" >>"$LOG"
    fi

    # zsh
    if [ "$both" = yes ]; then
        if timeout 60 "$tool" $argv zsh > "$CDIR/._$tool.tmp" 2>>"$LOG"; then
            mv -f "$CDIR/._$tool.tmp" "$CDIR/_$tool" && did=1
        else
            rm -f "$CDIR/._$tool.tmp"
            printf '%s: zsh generator failed\n' "$tool" >>"$LOG"
        fi
    fi

    if [ "$did" = 1 ]; then
        changed=1
        say "regenerated $tool completions ($fp)"
        printf '%s refresh: %s (%s)\n' "$(date -Is)" "$tool" "$fp" >>"$LOG"
    fi
done <<EOF
$TOOLS
EOF

# Shipped-file tools (see SHIPPED above). Same fingerprint/regen rules as the
# generated tools; the only difference is the "generator" is a copy out of the
# package's completions/ directory, and it may cover more than one command.
while IFS='|' read -r tool cmds; do
    [ -n "${tool:-}" ] || continue

    if ! command -v "$tool" >/dev/null 2>&1; then
        printf '%s: not on PATH, skipping (shipped)\n' "$tool" >>"$LOG"
        continue
    fi

    where=$(mise where "$tool" 2>/dev/null) || {
        printf '%s: mise where failed, skipping (shipped)\n' "$tool" >>"$LOG"
        continue
    }
    sdir=$(find "$where" -type d -name completions -print -quit 2>/dev/null)
    [ -n "$sdir" ] || {
        printf '%s: no completions dir under %s (shipped)\n' "$tool" "$where" >>"$LOG"
        continue
    }

    fp=$(fingerprint "$tool") || {
        printf '%s: could not read --version, skipping (shipped)\n' "$tool" >>"$LOG"
        continue
    }
    printf '%s=%s\n' "$tool" "$fp" >> "$CDIR/.versions.new"

    # Skip when nothing changed: same fingerprint and the first command's bash
    # file is already on disk.
    if [ "$regen" = 0 ] && [ "$fp" = "$(previous_for "$tool")" ] &&
       [ -s "$CDIR/${cmds%% *}.bash" ]; then
        continue
    fi

    did=0
    for c in $cmds; do
        for s in "$c.bash" "_$c"; do
            src="$sdir/$s"; dst="$CDIR/$s"
            if [ ! -f "$src" ]; then
                printf '%s: missing shipped %s (shipped)\n' "$tool" "$src" >>"$LOG"
                continue
            fi
            if ! cmp -s "$src" "$dst"; then
                # Write to a temp then move, like the generator path: a partial
                # copy must never replace a working script under a live shell.
                if cp -f "$src" "$CDIR/.ship.$$.tmp" 2>>"$LOG"; then
                    mv -f "$CDIR/.ship.$$.tmp" "$dst" && did=1
                else
                    rm -f "$CDIR/.ship.$$.tmp"
                fi
            fi
        done
    done

    if [ "$did" = 1 ]; then
        changed=1
        say "copied $tool completions ($fp)"
        printf '%s shipped: %s (%s)\n' "$(date -Is)" "$tool" "$fp" >>"$LOG"
    fi
done <<EOF
$SHIPPED
EOF

mv -f "$CDIR/.versions.new" "$STAMP"

# Manifest of tools that actually have a bash script on disk. The loader reads
# this rather than keeping its own copy of the table, so adding a tool here is
# the only edit needed and the two cannot drift.
: > "$CDIR/.tools.tmp"
for f in "$CDIR"/*.bash; do
    [ -e "$f" ] || continue
    basename "$f" .bash >> "$CDIR/.tools.tmp"
done
mv -f "$CDIR/.tools.tmp" "$CDIR/.tools"

say "completion refresh: $changed regenerated, $(printf '%s' "$TOOLS" | grep -c '|') generated + $(printf '%s' "$SHIPPED" | grep -c '|') shipped tools checked"