{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "io.github.jburchel.jarvis"
        },
        {
          "id": "omaplug",
          "autoCheckUpdates": true,
          "autoCheckIntervalHours": 1
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "oxquan.pixel-spirit"
        }
      ],
      "left": [
        {
          "id": "evindor.keystroke"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.active-window"
        },
        {
          "id": "khephri.sia",
          "cockpitWorkspace": ""
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "ozz1ee.hermbot"
        },
        {
          "id": "davedes.omadoctor"
        },
        {
          "id": "filipharald.oma-mise"
        },
        {
          "id": "akitaonrails.ai-usagebar",
          "barWindow": "weekly",
          "colorCodeUsage": true,
          "lastSelectedEntryId": "kilo",
          "showAll": false,
          "showProvider": false,
          "showValue": false,
          "uiLocale": "en"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "khephri.worldline"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "oliverlukschander.super-plugin-search"
    },
    {
      "id": "angus.beeline"
    },
    {
      "id": "robson.agent-chat"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "evindor.keystroke"
  ]
}
