{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omaplug",
          "autoCheckUpdates": true,
          "autoCheckIntervalHours": 1
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "ozz1ee.hermbot",
          "showWork": "false"
        }
      ],
      "left": [
        {
          "id": "evindor.keystroke"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "evindor.keystroke"
  ]
}
