{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Copenhagen",
              "zone": "Europe/Copenhagen"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omaplug"
        }
      ],
      "left": [
        {
          "id": "evindor.keystroke"
        },
        {
          "id": "omarchy.active-window"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "ozz1ee.hermbot"
        },
        {
          "id": "omarchy.spacer",
          "size": 383
        }
      ],
      "right": [
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "liambeck99.update-center"
        },
        {
          "id": "filipharald.oma-mise"
        },
        {
          "id": "io.github.momostifler96.omarchy-cleaner"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "davedes.omadoctor"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "io.github.twiking.omacontrol",
          "showBatteryWarnings": true,
          "showNetworkWarning": true,
          "showActiveSwitchCount": true
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "disabledPlugins": [
    "omarchy.nightlight",
    "omarchy.menu",
    "omarchy.battery",
    "omarchy.wifiqr"
  ],
  "idle": {
    "lock": 1800,
    "screensaver": 600
  },
  "plugins": [
    {
      "id": "io.github.iryzhkov.voxscope",
      "compact": true,
      "position": "bottom"
    },
    {
      "id": "oliverlukschander.super-plugin-search"
    },
    {
      "id": "io.github.dries-robuxio.tidy"
    },
    {
      "id": "chispes.agent-gemini"
    },
    {
      "id": "mirador"
    },
    {
      "id": "angus.beeline"
    },
    {
      "id": "io.github.jburchel.omarchy-alt-tab"
    }
  ],
  "version": 1,
  "cloneSourceRestores": [
    "evindor.keystroke"
  ]
}
