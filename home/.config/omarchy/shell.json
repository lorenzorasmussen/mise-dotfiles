{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "gotar.omarchy-themes"
        },
        {
          "id": "io.github.argusguardian.freemodels"
        },
        {
          "id": "jesseburlamaque.antigravity-usage"
        },
        {
          "id": "omaplug"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.active-window"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 383
        }
      ],
      "right": [
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.dahep.opencode-usage"
        },
        {
          "id": "filipharald.oma-mise"
        },
        {
          "id": "ozz1ee.hermbot"
        },
        {
          "id": "io.github.momostifler96.omarchy-cleaner"
        },
        {
          "id": "calmasacow.grok-usage"
        },
        {
          "id": "akitaonrails.ai-usagebar",
          "lastSelectedEntryId": "ollama",
          "showProvider": true,
          "colorCodeUsage": true,
          "showAll": true
        },
        {
          "id": "davedes.omadoctor"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "io.github.twiking.omacontrol",
          "showBatteryWarnings": true,
          "showNetworkWarning": true,
          "showActiveSwitchCount": true
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "disabledPlugins": [
    "omarchy.nightlight",
    "evindor.keystroke"
  ],
  "idle": {
    "lock": 1800,
    "screensaver": 600
  },
  "plugins": [
    {
      "id": "io.github.iryzhkov.voxscope",
      "compact": true,
      "position": "bottom"
    },
    {
      "id": "oliverlukschander.super-plugin-search"
    },
    {
      "id": "io.github.dries-robuxio.tidy"
    },
    {
      "id": "chispes.agent-gemini"
    },
    {
      "id": "io.github.mrlarsendk.cursor-usage"
    },
    {
      "id": "mirador"
    },
    {
      "id": "angus.beeline"
    },
    {
      "id": "io.github.jburchel.omarchy-alt-tab"
    }
  ],
  "version": 1,
  "cloneSourceRestores": [
    "evindor.keystroke"
  ]
}
