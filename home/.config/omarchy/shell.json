{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "omaplug",
          "autoCheckUpdates": true,
          "autoCheckIntervalHours": 1
        }
      ],
      "left": [
        {
          "id": "evindor.keystroke"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "oliverlukschander.super-plugin-search"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "aurora",
      "openAs": "panel"
    },
    {
      "id": "mirador"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "evindor.keystroke",
    "io.github.sirjul1337.lock-explorer"
  ]
}
