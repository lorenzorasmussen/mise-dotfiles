{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "gotar.omarchy-themes"
        },
        {
          "id": "io.github.dahep.opencode-usage"
        },
        {
          "id": "calmasacow.grok-usage"
        },
        {
          "id": "ozz1ee.hermbot",
          "barMetric": "none",
          "ordering": "gateway",
          "instance": "local",
          "showPinned": "true"
        }
      ],
      "left": [
        {
          "id": "evindor.keystroke"
        },
        {
          "id": "omarchy.active-window"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 39
        },
        {
          "id": "omarchy.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "filipharald.oma-mise"
        },
        {
          "id": "davedes.omadoctor"
        },
        {
          "id": "hass"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "io.github.momostifler96.omarchy-cleaner"
        },
        {
          "id": "omaplug",
          "autoCheckUpdates": true,
          "autoCheckIntervalHours": 1
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "io.github.twiking.omacontrol",
          "showActiveSwitchCount": false,
          "showBatteryWarnings": false
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 1800,
    "screensaver": 600
  },
  "plugins": [
    {
      "id": "oliverlukschander.super-plugin-search"
    },
    {
      "id": "mirador"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "aurora",
      "openAs": "panel"
    },
    {
      "id": "io.github.jburchel.omarchy-alt-tab"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "evindor.keystroke",
    "io.github.sirjul1337.lock-explorer"
  ]
}
